# Copy to .env.local for local development. On Vercel set the same keys in
# Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are visible in the browser. Everything else is server-only.

# ── Site ──────────────────────────────────────────────────────────────
# Public site URL (sitemap, canonical links, payment return URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Social links in the footer (optional).
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TELEGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TIKTOK=

# ── Firebase (client) ─────────────────────────────────────────────────
# Firebase console → Project settings → Your apps → Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase (server, secret) ─────────────────────────────────────────
# Service account JSON (Project settings → Service accounts → Generate key),
# pasted as one line or base64-encoded.
FIREBASE_SERVICE_ACCOUNT=

# Comma-separated emails that become admins after they sign up and verify the address.
# Lets you get the first admin without the command line. Removing an email here does
# not take the role away: do that in the admin panel (Users → Remove admin).
ADMIN_EMAILS=

# ── Local emulators (development only, see README) ───────────────────
# NEXT_PUBLIC_FIREBASE_EMULATORS=true
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-lexify
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-lexify.appspot.com
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ── AI scoring and speech-to-text (server, secret) ────────────────────
# Leave empty to use the built-in demo scorer. Any OpenAI-compatible API works.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
STT_PROVIDER=
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

# ── Payments ──────────────────────────────────────────────────────────
# false: every plan is free (launch mode). true: prices are charged through PAYMENT_PROVIDER.
NEXT_PUBLIC_PAYMENTS_ENABLED=false
# Provider id from server/payments/providers ("sandbox" = test card page, dev only).
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
