# Telegram Bot (optional — only needed to run `python -m app.main`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY_URL=

# MySQL
DATABASE_URL=

# Groq API
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Redis (optional — caching is skipped if unavailable)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400

# App Settings
LOG_LEVEL=INFO
BOT_MODE=polling
# Set to "webhook" for production, "polling" for local development
# WEBHOOK_URL is the base URL only — the app appends "/webhook" itself.
# WEBHOOK_URL=https://yourdomain.com
# WEBHOOK_SECRET is required in production: without it, anyone who finds the
# webhook URL can POST forged Telegram updates impersonating any user.
# WEBHOOK_SECRET=a-long-random-string

# Web platform
JWT_SECRET=change-me-in-production
WEB_PORT=8001
# Comma-separated list of allowed browser origins for the web API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
